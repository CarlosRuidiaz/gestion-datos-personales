# Variables de entorno de Gestión de Datos Personales.
# Copia este archivo como .env y completa los valores. El archivo .env NO se sube al repositorio.
# Usa contraseñas distintas y solo para este proyecto. Nunca escribas valores reales aquí.

# --- General -----------------------------------------------------------------
TZ=America/Bogota

# --- PostgreSQL (contenedor postgres) -----------------------------------------
# Superusuario: solo lo usan el contenedor y database/init.sql, nunca los servicios.
POSTGRES_DB=gestion_personas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Host y puerto dentro de la red "datos" (no se publican fuera de Docker).
DB_HOST=postgres
DB_PORT=5432

# Contraseñas de los usuarios de base de datos por servicio (sección 6.3 del diseño).
# Los usuarios son fijos: usr_crear, usr_modificar, usr_consultar, usr_borrar, usr_log, usr_n8n.
# Son obligatorias. Se asignan una sola vez, al crear la base de datos: si las cambias
# después, recrea el volumen con "docker compose down -v" (borra los datos locales).
DB_PASSWORD_CREAR=
DB_PASSWORD_MODIFICAR=
DB_PASSWORD_CONSULTAR=
DB_PASSWORD_BORRAR=
DB_PASSWORD_LOG=
DB_PASSWORD_N8N=

# --- Keycloak -------------------------------------------------------------------
# Administrador de la consola de Keycloak (http://localhost:8080). No es un usuario de la aplicación.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Realm y cliente del frontend. Están definidos en keycloak/realm.json: no los cambies solo aquí.
KEYCLOAK_REALM=gestion-personas
KEYCLOAK_CLIENT_ID=frontend
# Contraseñas de los usuarios de prueba de la aplicación: admin.prueba (rol administrador)
# y consultor.prueba (rol consultor). Obligatorias. Se asignan al importar el realm por
# primera vez; para cambiarlas después hay que recrear el volumen keycloak_data.
KEYCLOAK_USUARIO_ADMIN_PASSWORD=
KEYCLOAK_USUARIO_CONSULTOR_PASSWORD=
# URL con la que el navegador llega a Keycloak (emisor de los tokens).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# URL con la que los microservicios llegan a Keycloak dentro de Docker (llaves públicas).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# --- Frontend (tarea T11) -------------------------------------------------------
# URL pública de la aplicación (gateway) y del chat de n8n.
APP_PUBLIC_URL=http://localhost
N8N_CHAT_URL=

# --- n8n (tareas T14 y T15) -----------------------------------------------------
# Llave con la que n8n cifra sus credenciales. Genera una cadena aleatoria larga y no la cambies después.
N8N_ENCRYPTION_KEY=
# URL del webhook de indexación que llaman ms-crear, ms-modificar y ms-borrar.
N8N_WEBHOOK_INDEXACION_URL=http://n8n:5678/webhook/indexar-persona
# Llave de API que n8n envía a ms-log en POST /api/log/consulta-nl (cabecera X-API-Key).
# Obligatoria desde T10: sin ella docker compose no arranca. Genera una cadena aleatoria larga
# (en Git Bash: openssl rand -hex 32). En T15 se configura la misma llave dentro de n8n.
N8N_LOG_API_KEY=

# --- Modelos de lenguaje --------------------------------------------------------
# Google Gemini (chat y embeddings, nivel gratuito). Se carga también como credencial dentro de n8n.
GEMINI_API_KEY=
# Groq (respaldo, solo chat). Opcional.
GROQ_API_KEY=
